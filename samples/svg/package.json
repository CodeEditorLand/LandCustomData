    "@types/turndown": "^5.0.5",
    "@types/vscode": "^1.100.0",
    "cheerio": "1.0.0",
    "mdn-data": "^2.21.0",
    "turndown": "^7.2.0",
    "typescript": "^5.8.3"
  }
}
